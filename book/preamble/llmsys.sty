\definecolor{srcgray}{HTML}{555555}

% Palette for TikZ figures
\colorlet{fcompute}{sysblue!70}
\colorlet{fmemory}{napkin!80}
\colorlet{fcomm}{labpurple!75}
\colorlet{fdata}{keygreen!75}

% ---------------------------------------------------------------- code
\RequirePackage{listings}
\lstdefinestyle{py}{
  language=Python,
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebg},
  keywordstyle=\color{codekw}\bfseries,
  commentstyle=\color{codecomment}\itshape,
  stringstyle=\color{codestr},
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  frame=leftline,
  framerule=2pt,
  rulecolor=\color{sysblue!50},
  xleftmargin=8pt,
  framexleftmargin=6pt,
  numbers=left,
  numberstyle=\tiny\color{codecomment},
  numbersep=6pt,
  tabsize=4,
  upquote=true,
  literate={≈}{{$\approx$}}1 {→}{{$\rightarrow$}}1 {×}{{$\times$}}1 {≤}{{$\le$}}1 {≥}{{$\ge$}}1,
  morekeywords={self,None,True,False,torch,nn,with,as,yield,lambda,assert}
}
\lstdefinestyle{shell}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebg},
  frame=leftline, framerule=2pt, rulecolor=\color{keygreen!50},
  xleftmargin=8pt, framexleftmargin=6pt,
  breaklines=true, columns=fullflexible, keepspaces=true, showstringspaces=false
}
\lstdefinestyle{plain}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebg},
  breaklines=true, columns=fullflexible, keepspaces=true, showstringspaces=false
}
\lstdefinestyle{cpp}{
  language=C++,
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebg},
  keywordstyle=\color{codekw}\bfseries,
  commentstyle=\color{codecomment}\itshape,
  stringstyle=\color{codestr},
  showstringspaces=false, breaklines=true, columns=fullflexible, keepspaces=true,
  frame=leftline, framerule=2pt, rulecolor=\color{warnred!50},
  xleftmargin=8pt, framexleftmargin=6pt,
  numbers=left, numberstyle=\tiny\color{codecomment}, numbersep=6pt, tabsize=4, upquote=true,
  literate={≈}{{$\approx$}}1 {→}{{$\rightarrow$}}1 {×}{{$\times$}}1 {≤}{{$\le$}}1 {≥}{{$\ge$}}1,
  morekeywords={constexpr,nullptr,override,final,noexcept,static_assert,decltype,auto,
    int8_t,int16_t,int32_t,int64_t,uint8_t,uint16_t,uint32_t,uint64_t,size_t,
    Tensor,TORCH_LIBRARY,TORCH_LIBRARY_IMPL,TORCH_CHECK,TORCH_LIBRARY_FRAGMENT}
}
\lstdefinestyle{cuda}{
  style=cpp,
  rulecolor=\color{keygreen!60},
  morekeywords={__global__,__device__,__host__,__shared__,__restrict__,__launch_bounds__,
    __syncthreads,__syncwarp,__shfl_sync,__shfl_xor_sync,__shfl_down_sync,__ballot_sync,
    threadIdx,blockIdx,blockDim,gridDim,warpSize,dim3,cudaStream_t,cudaError_t,
    half,__half,__nv_bfloat16,bf16,float2,float4,int4,uint4,
    cp_async,wmma,mma,ldmatrix,cudaMalloc,cudaMemcpy,cudaMemcpyAsync,cudaFree,cudaDeviceSynchronize}
}
\lstdefinestyle{cmake}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebg},
  keywordstyle=\color{codekw}\bfseries,
  commentstyle=\color{codecomment}\itshape,
  stringstyle=\color{codestr},
  frame=leftline, framerule=2pt, rulecolor=\color{keygreen!50},
  xleftmargin=8pt, framexleftmargin=6pt,
  breaklines=true, columns=fullflexible, keepspaces=true, showstringspaces=false,
  morekeywords={cmake_minimum_required,project,add_library,add_executable,target_link_libraries,
    find_package,set,target_include_directories,target_compile_options,target_compile_features,
    add_subdirectory,install,option,if,else,endif,message,enable_language,pybind11_add_module},
  morecomment=[l]{\#}, morestring=[b]"
}
\lstset{style=py}
\renewcommand{\lstlistingname}{Listing}
% \code{...} inline code
\newcommand{\code}[1]{\texttt{\small #1}}
% \path-like verbatim for identifiers with underscores: \ident{lr_at}
\newcommand{\ident}[1]{\texttt{\small\detokenize{#1}}}

% ---------------------------------------------------------------- boxes
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{breakable,skins}
\tcbset{
  llmbox/.style={enhanced,breakable,boxrule=0.6pt,arc=2pt,left=8pt,right=8pt,
    top=6pt,bottom=6pt,fonttitle=\bfseries\small,
    before skip=10pt,after skip=10pt}
}
% Systems Lens: the systems view of a modeling concept
\newtcolorbox{systemslens}[1][]{llmbox,colback=sysbluebg,colframe=sysblue,
  title={Systems Lens\ifx\relax#1\relax\else: #1\fi}}
% Key idea
\newtcolorbox{keyidea}[1][]{llmbox,colback=keygreenbg,colframe=keygreen,
  title={Key Idea\ifx\relax#1\relax\else: #1\fi}}
% Pitfall / gotcha
\newtcolorbox{pitfall}[1][]{llmbox,colback=warnredbg,colframe=warnred,
  title={Pitfall\ifx\relax#1\relax\else: #1\fi}}
% Back-of-the-envelope calculation
\newtcolorbox{napkinmath}[1][]{llmbox,colback=napkinbg,colframe=napkin,
  title={Napkin Math\ifx\relax#1\relax\else: #1\fi}}
% Deeper dive / research note
\newtcolorbox{deepdive}[1][]{llmbox,colback=white,colframe=srcgray,
  title={Deeper Dive\ifx\relax#1\relax\else: #1\fi}}

% Exercises (numbered per chapter)
\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}
\newenvironment{exercise}[1][]{%
  \refstepcounter{exercise}%
  \par\medskip\noindent\textbf{Exercise \theexercise}\ifx\relax#1\relax\else\ (\emph{#1})\fi.\ }%
  {\par\medskip}

% Lab environment: big framed lab block at the end of each chapter
\newtcolorbox{labbox}[2]{enhanced,breakable,colback=labpurplebg,colframe=labpurple,
  boxrule=0.8pt,arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt,
  fonttitle=\bfseries,title={Lab #1: #2}}
\newcommand{\labdir}[1]{\par\noindent\textbf{Code:} \texttt{\small code/labs/\detokenize{#1}}\par}
\newcommand{\labsection}[1]{\par\smallskip\noindent{\color{labpurple}\textbf{#1}}\par}

% \covers{} is a no-op kept for backward compatibility
\newcommand{\covers}[1]{}
\setlength{\marginparwidth}{2.0cm}
\setlength{\marginparsep}{0.25cm}
\reversemarginpar

% ---------------------------------------------------------------- theorem-likes
\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{proposition}{Proposition}[chapter]
\newtheorem{example}{Example}[chapter]

