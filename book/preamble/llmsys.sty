\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{llmsys}[2026/11/01 LLM Systems textbook style]

% ---------------------------------------------------------------- fonts & layout
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
% lmodern typewriter is used for code
\RequirePackage{microtype}
\RequirePackage[a4paper,margin=2.6cm,headheight=14pt]{geometry}
\RequirePackage{setspace}
\setstretch{1.08}
\RequirePackage{parskip}

% ---------------------------------------------------------------- math
\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm}
\RequirePackage{siunitx}
\sisetup{group-separator={,},group-minimum-digits=4}

% ---------------------------------------------------------------- graphics
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,calc,shapes.geometric,shapes.misc,
  decorations.pathreplacing,backgrounds,matrix,chains,patterns}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}

% ---------------------------------------------------------------- tables, lists
\RequirePackage{booktabs,tabularx,longtable,multirow,array}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=4pt}
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf}

% ---------------------------------------------------------------- colours
\definecolor{sysblue}{HTML}{1F4E79}
\definecolor{sysbluebg}{HTML}{EAF1F8}
\definecolor{keygreen}{HTML}{2E6B30}
\definecolor{keygreenbg}{HTML}{EDF6EC}
\definecolor{warnred}{HTML}{9B2C2C}
\definecolor{warnredbg}{HTML}{FBEDED}
\definecolor{napkin}{HTML}{8A5A00}
\definecolor{napkinbg}{HTML}{FFF7E6}
\definecolor{labpurple}{HTML}{4B2C83}
\definecolor{labpurplebg}{HTML}{F2EEF9}
\definecolor{codebg}{HTML}{F7F7F7}
\definecolor{codecomment}{HTML}{6A737D}
\definecolor{codekw}{HTML}{0B5CAD}
